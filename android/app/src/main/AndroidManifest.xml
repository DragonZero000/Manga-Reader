<?xml version="1.0" encoding="utf-8"?>
<!-- По шаблону fyne package (fyne.io/tools): GoNativeActivity загружает
     libmangareader.so по android.app.lib_name. Встроенный браузер —
     BrowserActivity (GeckoView) в той же задаче, загрузки — DownloadService. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="MangaReader"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true">
        <activity
            android:name="org.golang.app.GoNativeActivity"
            android:label="MangaReader"
            android:configChanges="orientation|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@android:style/Theme">
            <meta-data android:name="android.app.lib_name" android:value="mangareader" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="org.golang.app.FyneNotificationReceiver" android:exported="false" />

        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <service
            android:name=".browser.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
